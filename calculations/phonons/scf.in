&CONTROL
    calculation  = "scf"
    outdir       = "."
    prefix       = "crsi2n4"
    pseudo_dir   = "../../../pseudo/ONCVPSP/abinit"
    restart_mode = "from_scratch"
    verbosity    = "high"
/

&SYSTEM
    assume_isolated           = "2D"
    input_dft                 = "vdw-DF"
    ecutwfc                   = 80
    ibrav                = 4
    celldm(1)            = 5.470908
    celldm(3)            = 7.172907
    nat                       = 7
    ntyp                      = 3
    occupations               = "smearing"
    smearing                  = "gauss"
    degauss                   = 0.01
/

&ELECTRONS
    conv_thr         =  1.00000e-06
    diagonalization  = "david"
    mixing_beta      =  4.00000e-01
    startingpot      = "atomic"
    startingwfc      = "atomic+random"
/

