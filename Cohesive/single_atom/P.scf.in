&control
    calculation = 'scf',
    prefix = 'P',
    outdir = '.',
    pseudo_dir = './../pseudo/ONCVPSP/abinit'
/
&system
    ibrav = 0, 
    nat = 1, 
    ntyp = 1,
    ecutwfc = 80.0,
    ecutrho = 480.0,
    occupations = 'smearing',
    smearing = 'gaussian',
    degauss = 0.01,
/
&electrons
  conv_thr = 1.0d-8
  mixing_beta = 0.7
/
ATOMIC_SPECIES
    P 30.974 P_ONCV_PBE_sr.upf
ATOMIC_POSITIONS angstrom
    P  50.0 15.0 15.0
K_POINTS gamma
CELL_PARAMETERS angstrom
    30.0  0.0  0.0
     0.0 30.0  0.0
     0.0  0.0 30.0
