&CONTROL
    calculation = 'scf',
    prefix = 'crsi2n4',
    outdir = '.',
    pseudo_dir = './../../pseudo/ONCVPSP/abinit',
    verbosity = 'high'
    restart_mode = "from_scratch"
/
 ! Preparing System for Hydrogen Adsorption !
&SYSTEM
    ibrav = 0,
    nat = 7,
    ntyp = 3,
    ecutwfc = 60,
    ecutrho = 300,
    occupations = 'fixed',
    degauss = 0.02,
    input_dft = 'vdw-DF'
/
&ELECTRONS
    conv_thr = 1.0d-6,
    mixing_beta = 0.7,
/

