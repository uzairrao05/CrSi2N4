&CONTROL
  calculation    = 'md',
  prefix         = 'crsi2n4',
  outdir         = './tmp/',
  restart_mode   = 'restart',
  pseudo_dir     = './../../pseudo/ONCVPSP/abinit',
  verbosity      = 'high',
  dt             = 20.0,
  nstep          = 11000,
/

&SYSTEM
  ibrav          = 4,
  a              = 2.84400,
  c              = 20.7661,
  nat            = 7,
  ntyp           = 3,
  ecutwfc        = 80,
  ecutrho        = 400,
  assume_isolated = '2D',
  occupations    = 'smearing',
  smearing       = 'fd',     
  degauss        = 0.005,
/

&ELECTRONS
  conv_thr         = 1.0d-6,
  mixing_beta      = 0.1,
  mixing_ndim      = 4,
  mixing_mode      = 'local-TF'
  electron_maxstep = 400,
/

&IONS
  ion_dynamics   = 'verlet',
  ion_temperature= 'andersen',
  tempw          = 300.0,
  nraise          = 10,
/

ATOMIC_SPECIES
Cr     51.99600  Cr_ONCV_PBE_sr.upf
Si     28.08600  Si_ONCV_PBE_sr.upf
N      14.00700  N_ONCV_PBE_sr.upf

